DEV_ASSISTANT_APP_NAME=AI GitHub Repository Agent
DEV_ASSISTANT_ENVIRONMENT=development
DEV_ASSISTANT_LOG_LEVEL=INFO
DEV_ASSISTANT_LLM_PROVIDER=openai
# Set both secrets in the host's secret manager before a public deployment.
# DEV_ASSISTANT_API_ACCESS_TOKEN=
# DEV_ASSISTANT_DEMO_ACCESS_PASSWORD=
# Maximum generated tokens per answer; this limits output length, not total API spend.
DEV_ASSISTANT_LLM_MAX_OUTPUT_TOKENS=1200
# Optional override; defaults are provider-specific.
DEV_ASSISTANT_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Local model files are cached here; the first run downloads them if needed.
DEV_ASSISTANT_EMBEDDING_CACHE_DIRECTORY=data/huggingface
# Optional GitHub fine-grained token with read-only Contents, Pull requests,
# and Issues permissions (private repos only).
# DEV_ASSISTANT_GITHUB_TOKEN=
# Maximum GitHub PR diff size downloaded for advisory reviews (bytes).
# DEV_ASSISTANT_GITHUB_MAX_PULL_REQUEST_DIFF_BYTES=2097152
# REST is the default. MCP mode requires Docker and a GitHub token.
# DEV_ASSISTANT_GITHUB_ACTIVITY_BACKEND=rest
# DEV_ASSISTANT_GITHUB_MCP_COMMAND=docker
# DEV_ASSISTANT_GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server:latest
# Optional: exact extension ID shown on chrome://extensions after loading unpacked.
# DEV_ASSISTANT_CHROME_EXTENSION_ID=
# DEV_ASSISTANT_OPENAI_API_KEY=
# DEV_ASSISTANT_ANTHROPIC_API_KEY=
# Put the selected provider key in your ignored local .env file; never commit it.
